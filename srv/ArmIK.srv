string method          # 逆解方法：A1_minimum_jv、minimum_sufficient_continuity_refined 或旧 feasible/optimal 方法
float64[7] init_joints # 初始关节角度
geometry_msgs/Pose target_pose # 目标位姿
float64 current_arm_angle # 手臂角度
float64[] offset_list   # 可选的偏移列表
float64 offset_refer  # 偏移参考值
---
float64[7] solution    # 求解结果关节角度
float64 new_arm_angle # 新的手臂角度
bool success           # 是否求解成功
string message         # 详细结果信息
int32 search_cnt
# Per-call selector diagnostics (microseconds). Unsupported/legacy methods leave
# timing_valid=false. Stage zeros mean unrecorded/not reached, not a free solve.
bool timing_valid
bool target_is_moving
string timing_runtime_mode
float64 selector_call_us
float64 selector_elapsed_us
float64 context_build_us
float64 phi1_us
float64 phi2_us
float64 motion_selection_us
float64 offset_execution_us
float64 actuator_conversion_us
# Exclusive five-stage paper timing, schema 2. Guard/unsupported profiles set
# paper_timing_valid=false; static calls have no executed stages.
uint32 timing_schema_version
bool paper_timing_valid
float64 stage1_baseline_us
float64 stage2_gate_us
float64 stage3_motion_domain_us
float64 stage4_wrist_candidates_us
float64 stage5_temporal_selection_us
bool stage1_executed
bool stage2_executed
bool stage3_executed
bool stage4_executed
bool stage5_executed
float64 selector_other_us
string selector_mode
string wrist_skip_reason
